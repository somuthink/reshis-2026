{:scriptorium/system
 {:extra-resolvers [#ig/ref :app.resolvers.route/resolvers
                    #ig/ref :app.mutations.scenario/mutations
                    #ig/ref :app.mutations.user/mutations
                    #ig/ref :app.resolvers.user/resolvers]
  :env {:app.acl/client #ig/ref :scriptorium.eacl/client}}

 :app.resolvers.route/resolvers {}
 :app.mutations.scenario/mutations {}
 :app.mutations.user/mutations {}
 :app.resolvers.user/resolvers {}

 :scriptorium.eacl/client
 {:extra-relations [{:relation :viewer :subject-type :user :resource-type :route}
                    {:relation :viewer :subject-type :user :resource-type :city}]}

 :app.reitit.middleware/handler
 {:handler #ig/ref :scriptorium.reitit.ring/ring-handler
  :pathom-env #ig/ref :scriptorium.pathom.env/env
  :public-origin #env PUBLIC_ORIGIN
  :registry #ig/ref :scriptorium/registry}

 :scriptorium/registry
 {:entities
  #:app.entities{:route #include "entities/route.edn"
                 :forecast #include "entities/forecast.edn"
                 :city #include "entities/city.edn"
                 :scenario #include "entities/scenario.edn"
                 :user #include "entities/user.edn"}}

 :scriptorium.datahike/conn
 {:store {:backend :file
          :path #or [#env DATABASE_PATH "data/routes-db"]
          :id #uuid "f67b64bd-57bb-49fb-a998-3b28530bb800"}
  :schema-flexibility :write}

 :scriptorium.reitit.ring/router
 {:routes ["" #include "routes/routes.edn"]}

 :scriptorium.http-kit/server
 {:port #long #or [#env PORT 3000]
  :ip #or [#env IP "0.0.0.0"]
  :handler #ig/ref :app.reitit.middleware/handler}}
