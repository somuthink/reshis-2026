[:map {:stored? false :eacl/resource :app.acl/subject-resource}
 [:scenario/id {:identity? true} :string]
 [:scenario/from {:>label "Откуда"
                  :>in [{:route/origin-cities [:city/id :city/name]}]
                  :>options {:source :route/origin-cities :value :city/id :label :city/name}} [:s/ref :city/id]]
 [:scenario/to {:>label "Куда"
                :>in [{:route/destination-cities [:city/id :city/name]}]
                :>options {:source :route/destination-cities :value :city/id :label :city/name}} [:s/ref :city/id]]
 [:scenario/date
  {:>label "Дата"
   :>style :date
   :>attrs {:aria-label "Дата вылета"}
   :>in [:route/forecast-dates]
   :>options {:source :route/forecast-dates :value :forecast/date}}
  :time/local-date]
 [:scenario/price
  {:>label "Цена, ₽"
   :>style :slider
   :>in [{:route/selected [:route/price-min :route/base-price :route/price-max]}]
   :>options {:source :route/selected :min :route/price-min :base :route/base-price :max :route/price-max}}
  :double]
 [:scenario/route
  {:resolve :app.resolvers.scenario/route-selection
   :in [{:scenario/from [:city/id]} {:scenario/to [:city/id]}]}
  [:s/ref :route/id]]
 [:scenario/forecast
  {:resolve :app.resolvers.scenario/forecast-selection
   :in [:scenario/date {:scenario/route [:route/id]}]}
  [:s/ref :forecast/id]]
 [:scenario/estimate
  {:resolve :app.resolvers.scenario/estimate
   :in [:scenario/date :scenario/price
        {:scenario/from [:city/id]} {:scenario/to [:city/id]}
        {:scenario/route [:route/id :route/name :route/base-price :route/price-sensitivity]}
        {:scenario/forecast [:forecast/id :forecast/seats :forecast/demand-q50]}]}
  :any]
 [:scenario/distribution
  {:resolve :app.resolvers.scenario/distribution
   :in [:scenario/price
        {:scenario/route [:route/id :route/base-price :route/price-sensitivity]}
        {:scenario/forecast [:forecast/id :forecast/demand-q10 :forecast/demand-q20
                             :forecast/demand-q30 :forecast/demand-q40
                             :forecast/demand-q50 :forecast/demand-q60
                             :forecast/demand-q70 :forecast/demand-q80
                             :forecast/demand-q90]}]}
  :any]
 [:scenario/>date
  {:resolve :app.views.fields/date-field
   :params [:map {:closed true} [:label? {:optional true} :boolean]]
   :in [(:scenario/date {:com.wsscode.pathom3.connect.operation/optional? true})
        :route/forecast-dates]}
  :hiccup]
 [:scenario/>form
  {:resolve :app.views.scenario/form
   :in [:scenario/>from :scenario/>to (:scenario/>date {:label? false}) :scenario/>price]}
  :hiccup]
 [:scenario/>chart
  {:resolve :app.views.scenario/chart
   :in [:scenario/distribution :scenario/estimate]}
  :hiccup]
 [:scenario/target-price
  {:resolve :app.resolvers.scenario/target-price
   :params [:map {:closed true} [:target [:int {:min 1}]]]
   :in [:scenario/estimate
        {:scenario/route [:route/base-price :route/price-sensitivity :route/price-min :route/price-max]}]}
  :any]
 [:scenario/>result
  {:resolve :app.views.scenario/result
   :in [:scenario/estimate :scenario/>chart
        {:scenario/route [:route/>link]}]}
  :hiccup]]
