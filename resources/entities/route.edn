[:map
 [:route/id {:identity? true} :string]
 [:route/origin-city [:s/ref :city/id]]
 [:route/destination-city [:s/ref :city/id]]
 [:route/name :string]
 [:route/base-price :double]
 [:route/cost-per-passenger :double]
 [:route/price-sensitivity :double]
 [:route/price-min :double]
 [:route/price-max :double]
 [:route/forecasts {:db/isComponent true}
  [:vector [:s/ref :forecast/id]]]
 [:route/>link {:resolve :app.views.route/link
                :in [:route/id :route/name]}
  :hiccup]
 [:route/>view {:resolve :app.views.route/detail
                :in [:route/id :route/name :route/base-price
                     :route/cost-per-passenger :route/price-sensitivity
                     :route/price-min :route/price-max
                     {:route/origin-city [:city/>link]}
                     {:route/destination-city [:city/>link]}
                     {:route/forecasts [:forecast/date :forecast/>row]}]}
  :hiccup]]
