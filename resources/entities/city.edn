[:map
 [:city/id {:identity? true} :string]
 [:city/name :string]
 [:city/outgoing-routes {:where [[?r :route/origin-city ?e]]}
  [:vector [:s/ref :route/id]]]
 [:city/incoming-routes {:where [[?r :route/destination-city ?e]]}
  [:vector [:s/ref :route/id]]]
 [:city/>link {:resolve :app.views.city/link
               :in [:city/id :city/name]}
  :hiccup]
 [:city/>view {:resolve :app.views.city/detail
               :in [:city/id :city/name
                    {:city/outgoing-routes [:route/id :route/name :route/>link]}
                    {:city/incoming-routes [:route/id :route/name :route/>link]}]}
  :hiccup]]